        RowBox[{"ArrayPlot", "[", 
         RowBox[{"data", ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "maxval"}], ",", "maxval"}], "}"}]}], ",", "opts", ",", 
          RowBox[{"Frame", "->", "False"}], ",", 
          RowBox[{"ColorFunction", "->", "cmap"}], ",", 
          RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
          RowBox[{"PlotRangePadding", "->", "None"}], ",", 
          RowBox[{"Background", "->", "Transparent"}]}], "]"}]}]}], "]"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "realArrayPlot", "]"}], "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<ClipColors\>\"", "->", "False"}], "}"}], ",", 
       RowBox[{"Options", "[", "ArrayPlot", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"realArrayPlot", "[", 
     RowBox[{"data_", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "cmap", ",", "maxval", ",", "pr", ",", "minColor", ",", "maxColor", ",",
         "doClip", ",", "cStyle"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Extract", " ", "options"}], "*)"}], 
      RowBox[{
       RowBox[{"pr", "=", 
        RowBox[{"OptionValue", "[", "PlotRange", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"doClip", "=", 
        RowBox[{"OptionValue", "[", "\"\<ClipColors\>\"", "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Read", " ", "our", " ", "custom", " ", "option"}], "*)"}], 
       RowBox[{"maxval", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"pr", "===", "All"}], ",", 
          RowBox[{"Max", "@", 
           RowBox[{"Abs", "@", 
            RowBox[{"Re", "@", "data"}]}]}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ListQ", "[", "pr", "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", "pr", "]"}], "]"}], ",", 
            RowBox[{"Abs", "[", "pr", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minColor", "=", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.192", ",", "0.443", ",", "0.674"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Muted", " ", "Blue"}], "*)"}], 
       RowBox[{"maxColor", "=", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.839", ",", "0.188", ",", "0.153"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Muted", " ", "Red"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "3.", " ", "Define", " ", "the", " ", "ColorFunction", " ", "based", " ",
          "on", " ", "the", " ", "doClip", " ", "option"}], "*)"}], 
       RowBox[{"cmap", "=", 
        RowBox[{
         RowBox[{"Blend", "[", 
