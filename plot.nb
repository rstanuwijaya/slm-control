           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.0", ",", "minColor"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0.5", ",", 
               RowBox[{"RGBColor", "[", 
                RowBox[{"0.97", ",", "0.97", ",", "0.97"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1.0", ",", "maxColor"}], "}"}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{"doClip", ",", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Rescale", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "maxval"}], ",", "maxval"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
             RowBox[{"Rescale", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "maxval"}], ",", "maxval"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "]"}]}], "]"}], 
         "&"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Determine", " ", "ClippingStyle", " ", "based", " ", "on",
          " ", "the", " ", "option"}], "*)"}], 
       RowBox[{"cStyle", "=", 
        RowBox[{"If", "[", 
         RowBox[{"doClip", ",", 
          RowBox[{"{", 
           RowBox[{"minColor", ",", "maxColor"}], "}"}], ",", "Automatic"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"5.", " ", "Render", " ", "the", " ", "plot"}], "*)"}], 
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "maxval"}], ",", "maxval"}], "}"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{"FilterRules", " ", "ensures", " ", "ArrayPlot", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "throw", " ", "an", " ", "error",
            " ", "about", " ", "our", " ", "custom", " ", "\"\<ClipColors\>\"",
            " ", "option"}], "*)"}], 
         RowBox[{"FilterRules", "[", 
          RowBox[{
           RowBox[{"{", "opts", "}"}], ",", 
           RowBox[{"Options", "[", "ArrayPlot", "]"}]}], "]"}], ",", 
         RowBox[{"Frame", "->", "False"}], ",", 
         RowBox[{"ColorFunction", "->", "cmap"}], ",", 
         RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
         RowBox[{"PlotRangePadding", "->", "None"}], ",", 
         RowBox[{"Background", "->", "Transparent"}], ",", 
         RowBox[{"ClippingStyle", "->", "cStyle"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "distancePlot", "]"}], "=", 
     RowBox[{"Join", "[", 
